//┃           ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫                         ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫  SCRL_UP  ┃
//┗━━━━━━━━━━━┫           ┃           ┃           ┃           ┃           ┃                         ┃   MB4     ┃   LCLK    ┃   MCLK    ┃   RCLK    ┃    MB5    ┣━━━━━━━━━━━┛
//            ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓ ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
//                                                ┃           ┃           ┃           ┃ ┃           ┃ SCRL_DOWN ┃   DOWN    ┃
//                                                ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛ ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <

            &trans       &trans      &trans       &none         &trans       &none           &none           &msc SCRL_UP  &none            &none
            &kp LGUI     &kp LALT    &kp LCTRL    &kp LSHIFT    &trans       &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_RIGHT  &msc SCRL_RIGHT
    &trans  &trans       &trans      &trans       &trans        &trans       &mkp MB4        &mkp LCLK       &mkp MCLK     &mkp RCLK        &mkp MB5         &msc SCRL_UP

                                                 &trans   &trans   &trans     &trans    &msc SCRL_DOWN    &mmv MOVE_DOWN
            >;

