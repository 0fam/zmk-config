//┃    ` ~    ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫                         ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫  SCRL_UP  ┃
//┗━━━━━━━━━━━┫   UNDO    ┃    CUT    ┃   COPY    ┃   PASTE   ┃     |     ┃                         ┃    INS    ┃   PgUp    ┃  PgDown   ┃  SCRL_UP  ┃ SCRL_DOWN ┣━━━━━━━━━━━┛
//            ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓ ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
//                                                ┃           ┃           ┃           ┃ ┃   PASTE   ┃   COPY    ┃   DOWN    ┃
//                                                ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛ ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <

              &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT          &kp CARET   &kp AMPS   &euro_sign   &kp SLASH     &kp BACKSLASH
              &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHIFT    &kp QMARK          &kp HOME    &kp LEFT   &kp UP       &kp RIGHT     &kp END
&kp GRAVE     &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp PIPE           &kp INSERT  &kp PG_UP  &kp PG_DN    &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_UP

                                                        &trans    &trans    &trans    &kp LS(INS)   &kp LC(INS)   &kp DOWN
            >;
        };

